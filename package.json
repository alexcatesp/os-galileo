{
  "name": "os-galileo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "probar:robot": "esbuild scripts/probar-robot.ts --bundle --platform=node --format=cjs --outfile=.tmp/probar-robot.cjs --log-level=error && node .tmp/probar-robot.cjs",
    "probar:autocompletar-lab": "esbuild scripts/probar-autocompletar-lab.ts --bundle --platform=node --format=cjs --outfile=.tmp/pal.cjs --log-level=error && node .tmp/pal.cjs",
    "probar:emmet-lab": "esbuild scripts/probar-emmet-lab.ts --bundle --platform=node --format=cjs --outfile=.tmp/pel.cjs --log-level=error && node .tmp/pel.cjs",
    "probar:isla": "esbuild scripts/probar-isla.ts --bundle --platform=node --format=cjs --outfile=.tmp/probar-isla.cjs --log-level=error && node .tmp/probar-isla.cjs"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.11",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "js-tiktoken": "^1.0.21",
    "sql.js": "^1.15.2"
  }
}
